{
  "name": "labia-painel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Painel da Lábia: lê só os arquivos do contrato de dados (results/*.json).",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "gen-types": "node scripts/gen-types.mjs",
    "dev": "npm run sync-data && vite",
    "build": "npm run sync-data && npm run gen-types && tsc -b && vite build",
    "typecheck": "npm run gen-types && tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "json-schema-to-typescript": "^15.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "vite": "^7.3.8"
  }
}
