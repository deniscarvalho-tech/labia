{
  "$defs": {
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "ci95": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci95"
        }
      },
      "required": [
        "model_id",
        "label",
        "value",
        "ci95"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "HeadlineCard": {
      "additionalProperties": false,
      "description": "Um cartão que se descreve sozinho: o portfólio e o painel só renderizam.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "enum": [
            "ratio",
            "usd",
            "brl",
            "seconds",
            "count"
          ],
          "title": "Unit",
          "type": "string"
        },
        "ci95": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci95"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "assumptions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assumptions"
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/Comparison"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "label",
        "model_id",
        "value",
        "unit",
        "ci95",
        "kind"
      ],
      "title": "HeadlineCard",
      "type": "object"
    },
    "Kind": {
      "enum": [
        "measured",
        "estimated"
      ],
      "title": "Kind",
      "type": "string"
    },
    "Version": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "released"
          ],
          "title": "Status",
          "type": "string"
        },
        "changes": {
          "items": {
            "type": "string"
          },
          "title": "Changes",
          "type": "array"
        },
        "headline": {
          "items": {
            "$ref": "#/$defs/HeadlineCard"
          },
          "title": "Headline",
          "type": "array"
        },
        "links": {
          "$ref": "#/$defs/VersionLinks"
        }
      },
      "required": [
        "version",
        "date",
        "title",
        "status",
        "changes",
        "headline",
        "links"
      ],
      "title": "Version",
      "type": "object"
    },
    "VersionLinks": {
      "additionalProperties": false,
      "properties": {
        "github_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Release"
        },
        "hf_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hf Model"
        },
        "hf_dataset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hf Dataset"
        },
        "space": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Space"
        },
        "article": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Article"
        },
        "panel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Panel"
        }
      },
      "title": "VersionLinks",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "is_sample": {
      "title": "Is Sample",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/Version"
      },
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "is_sample",
    "generated_at",
    "versions"
  ],
  "title": "VersionsFile",
  "type": "object",
  "$id": "https://github.com/deniscarvalho-tech/labia/schemas/versions.schema.json"
}
