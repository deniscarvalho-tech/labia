# Copie este arquivo para .env e preencha. O .env está no .gitignore e nunca vai para o git.
# Nunca cole o valor de uma chave no chat, num print ou num commit.

# Avaliação apenas (os termos gratuitos não permitem gerar dados de treino)
GOOGLE_AI_STUDIO_API_KEY=
NVIDIA_API_KEY=

# Publicação do modelo, do dataset e do Space
HF_TOKEN=

# Opcional: só se alguém quiser rodar a avaliação com uma chave paga
OPENROUTER_API_KEY=
